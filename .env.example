# ── Artifact API (mirrors the diagrams app) ───────────────────────────────────

# Secret token for the create-only agent API (POST /api/ai/boards) - the ONLY route that accepts it.
# Server-only. NEVER a NEXT_PUBLIC_*/VITE_* var, never referenced client-side.
# Generate with: openssl rand -hex 24
# Production refuses this exact placeholder value - lib/env.js fails the build/server if it is still set.
FORENSIC_API_SECRET="your-secret-token-here"

# Postgres connection string, e.g. postgresql://localhost:5432/forensic
# (add user:password@ and ?sslmode=require for a remote DB).
DATABASE_URL="postgresql://localhost:5432/forensic"
DATABASE_SSL="true" # "true" for remote Postgres. Without DATABASE_CA the cert is NOT verified (a boot warning says so in production).
# DATABASE_CA="" # PEM cert (or CA) to verify the DB TLS cert. Set it in prod (see lib/db.js).

# Owner UUID used as boards.user_id for API-created boards.
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"


# ── Owner Google sign-in ────────────────────────────────────────────────────
# Google OAuth 2.0 Web client (console.cloud.google.com -> Credentials).
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Session-cookie signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=""
# Only this Google account may sign in.
# Production refuses this exact placeholder value - lib/env.js fails the build/server if it is still set.
OWNER_EMAIL="you@example.com"

# Session-revocation lever (optional, unix seconds): sessions issued before
# this time are rejected even if their signature and exp are still valid. Set
# after a suspected leak to invalidate every token issued so far.
# SESSION_MIN_IAT=""

# DEV-ONLY auth bypass: treats loopback/LAN requests as the owner. Opt-in in EVERY
# environment. NEVER set on Vercel (prod or preview) - lib/env.js fails the build if it is.
# LOCAL_DEV="true"

# Local server port (optional, default 4336).
# PORT=""

# ── Platform vars (set by the environment, not usually written here) ───────
# NODE_ENV        - "production" enables lib/env.js's required-var validation
#                    (also true when VERCEL_ENV=production). Vite build / npm
#                    start set this themselves.
# VERCEL          - set automatically on any Vercel deployment (prod or preview).
# VERCEL_ENV      - "production" | "preview" | "development", set by Vercel.
# CI              - set by GitHub Actions; playwright.config.js uses it to
#                    disable dev-server reuse in CI.
# PGUSER          - read implicitly by `pg` if DATABASE_URL has no user; CI sets
#                    it to match the throwaway Postgres service.
